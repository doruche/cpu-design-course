# Local agent state
/.agents/
/.codex/

# Course downloads are recorded in materials/MANIFEST.md.
/materials/lab1/

# Machine-local configuration and caches
/local.mk
/.cache/
/dist/
*.Zone.Identifier

# Program build products
/programs/**/build/

# Vivado generated project state and outputs
**/.Xil/
**/*.cache/
**/*.gen/
**/*.hw/
**/*.ip_user_files/
**/*.runs/
**/*.sim/
**/*.srcs/
**/*.jou
**/*.log
**/*.pb
**/*.str
**/*.wdb
**/*.vcd
**/*.fst
**/*.bit
**/*.ltx

# The checked-in IP source is its XCI configuration. Vivado regenerates the
# remaining files with the matching tool version.
/projects/*/src/rtl/ip/**
!/projects/*/src/rtl/ip/
!/projects/*/src/rtl/ip/*/
!/projects/*/src/rtl/ip/*/*.xci
