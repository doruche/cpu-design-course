# Local agent state
/.agents/
/.codex/

# The official guide is a local snapshot, not a tracked input. Its provenance
# and the course downloads are recorded in docs/MANIFEST.md.
/docs/instruction-site/

# Machine-local configuration and caches
/local.env
/.cache/
/dist/
*.Zone.Identifier

# Program build products
/programs/**/build/

# Vivado generated project state and outputs
**/.Xil/
**/*.cache/
**/*.gen/
**/*.hw/
**/*.ip_user_files/
**/*.runs/
**/*.sim/
**/*.srcs/
**/*.jou
**/*.log
**/*.pb
**/*.str
**/*.wdb
**/*.vcd
**/*.fst
**/*.bit
**/*.ltx
/projects/*/artifacts/

# The checked-in IP source is its XCI configuration. Vivado regenerates the
# remaining files with the matching tool version.
/projects/*/src/rtl/ip/**
!/projects/*/src/rtl/ip/
!/projects/*/src/rtl/ip/*/
!/projects/*/src/rtl/ip/*/*.xci

__pycache__/
