# Optional WSL/Windows Vivado 2023.2 backend. Copy this file to ignored local.env.
# Values are literal: do not add `export` or quotes. Only the three keys below
# are accepted; already-exported environment variables of the same names win.
# Do not put identity, report/program paths, serial/board settings, or course
# material paths here. See docs/environment.md for the complete contract.

# Use WSL paths. scripts/vivado.sh converts them to Windows paths via wslpath.
# The staging root must be Windows-visible, disposable, and outside the
# canonical projects/<product>/ tree; generated Vivado outputs remain there.
VIVADO_BIN=/mnt/c/Xilinx/Vivado/2023.2/bin/vivado.bat
VIVADO_STAGE_ROOT=/mnt/c/cpu-design-vivado
VIVADO_JOBS=8
