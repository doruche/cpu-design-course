// DESCRIPTION: Verilator output: Waivers generated with --waiver-output

`verilator_config

// Below are suggested waivers. You have three options:
//   1. Fix the reason for the linter warning in the Verilog sources
//   2. Keep the waiver permanently if you are sure it is okay
//   3. Keep the waiver temporarily to suppress the output

lint_off -rule DECLFILENAME -file "*cdp-tests/vsrc/ram.v" -match "Filename 'ram' does not match MODULE name: 'IROM'*"

lint_off -rule WIDTHTRUNC -file "*projects/single_cycle/src/rtl/Inst_ROM.v" -match "Input port connection 'addra' expects 16 bits on the pin connection, but pin connection's SEL generates 30 bits.*"

lint_off -rule WIDTHTRUNC -file "*projects/single_cycle/src/rtl/Data_RAM.v" -match "Input port connection 'addra' expects 16 bits on the pin connection, but pin connection's SEL generates 30 bits.*"

lint_off -rule UNUSEDSIGNAL -file "*projects/single_cycle/src/rtl/miniRV_SoC.v" -match "Signal is not used: 'sw'*"

lint_off -rule UNDRIVEN -file "*projects/single_cycle/src/rtl/miniRV_SoC.v" -match "Signal is not driven: 'led'*"

lint_off -rule UNDRIVEN -file "*projects/single_cycle/src/rtl/miniRV_SoC.v" -match "Signal is not driven: 'dig_en'*"

lint_off -rule UNDRIVEN -file "*projects/single_cycle/src/rtl/miniRV_SoC.v" -match "Signal is not driven: 'dig_seg'*"

lint_off -rule UNDRIVEN -file "*projects/single_cycle/src/rtl/miniRV_SoC.v" -match "Signal is not driven: 'dig_seg1'*"

lint_off -rule UNUSEDSIGNAL -file "*projects/single_cycle/src/rtl/miniRV_SoC.v" -match "Signal is not used: 'rx'*"

lint_off -rule UNDRIVEN -file "*projects/single_cycle/src/rtl/miniRV_SoC.v" -match "Signal is not driven: 'tx'*"

lint_off -rule UNUSEDSIGNAL -file "*projects/single_cycle/src/rtl/Data_RAM.v" -match "Bits of signal are not used: 'data_addr'[1:0]*"

lint_off -rule UNUSEDSIGNAL -file "*projects/single_cycle/src/rtl/Inst_ROM.v" -match "Bits of signal are not used: 'inst_addr'[1:0]*"

lint_off -rule SYNCASYNCNET -file "*projects/single_cycle/src/rtl/miniRV_SoC.v" -match "Signal flopped as both synchronous and async: 'fpga_rst'*"
